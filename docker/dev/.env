### This file contains environment variables needed when building the dfirtrack Dockerfile
### Please set accordingly!

pg_user=dfirtrack
pg_password=dfirtrack
django_secret_key=sup3r_s3cr3t_k3y
openssl_o=testo
fqdn=localhost
openssl_ou=testou

# OIDC authentication variables for DFIRTrack
OIDC_ENABLED=False        # Set to True to enable OIDC authentication - if False no other variables have to be set in this block
OIDC_RP_CLIENT_ID=        # OIDC client ID
OIDC_RP_CLIENT_SECRET=    # OIDC client secret
OIDC_OP_AUTHORIZATION_ENDPOINT=   # OIDC authorization endpoint
OIDC_OP_TOKEN_ENDPOINT=   # OIDC token endpoint
OIDC_OP_USER_ENDPOINT=    # OIDC userinfo endpoint
OIDC_OP_JWKS_ENDPOINT=    # OIDC JWKS endpoint
OIDC_RP_SIGN_ALGO=        # OIDC signing algorithm (e.g., RS256)
SITE_URL=                 # Public URL of your DFIRTrack instance
